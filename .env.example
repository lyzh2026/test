# ============================================================
# 拾讯 (shixun) - 环境变量模板
# 用法：复制本文件为 .env，并填入下面各项的真实值
#       cp .env.example .env  (Linux/macOS)
#       copy .env.example .env  (Windows cmd)
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_PASSWORD=shixun_db_pwd_change_me
# Docker Compose 模式无需修改，自动使用容器内 hostname "postgres"
# 直接启动时改为 localhost
# DATABASE_URL=postgresql+asyncpg://shixun:shixun@localhost:5432/shixun
# DATABASE_URL_SYNC=postgresql+psycopg2://shixun:shixun@localhost:5432/shixun

# ---------- 管理员账号 ----------
# 仅使用单管理员模式（PRD ADR-02）
# 用户名固定为 admin，登录用此密码
ADMIN_PASSWORD=admin123

# ---------- Session 签名密钥 ----------
# 必须是足够随机的长字符串，建议：
#   Linux/macOS:  openssl rand -hex 32
#   Windows PS:   -join ((48..57)+(97..122) | Get-Random -Count 64 | %{[char]$_})
SESSION_SECRET=please_replace_with_random_64_char_string

# ---------- Kimi (Moonshot) AI ----------
# 申请地址：https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=sk-your-kimi-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-32k

# ---------- 初始白名单种子 ----------
# 仅在首次启动且 allowed_domains 表为空时灌入数据库
# 多个域名用逗号分隔
ALLOWED_DOMAINS=gov.cn,xinhuanet.com,people.com.cn,news.cn

# ---------- Redis ----------
# 直接启动时改为 localhost
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- 代理池 ----------
# 启用后 Playwright 渲染时会从代理池中选取代理轮换
PROXY_ENABLED=false
# 逗号分隔：protocol://user:pass@host:port
PROXY_LIST=
# 连续失败 N 次后自动禁用该代理
PROXY_MAX_CONSECUTIVE_FAILS=3

# ---------- 爬虫重试 ----------
# 单 URL 最多重试次数（网络抖动自动恢复）
CRAWLER_MAX_RETRIES=3
# 指数退避基数（秒）：2^1, 2^2, 2^3 ...
CRAWLER_RETRY_BACKOFF_BASE=2

# Content Filter
CONTENT_FILTER_ENABLED=True
CONTENT_FILTER_PRUNING_MIN_DENSITY=0.05
CONTENT_FILTER_BM25_TOP_K=30
CONTENT_FILTER_CHUNK_TOKEN_THRESHOLD=4000
CONTENT_FILTER_CHUNK_OVERLAP_RATE=0.1

# Page Cache
CRAWLER_CACHE_ENABLED=True
CRAWLER_CACHE_DEFAULT_TTL=3600
CRAWLER_CACHE_MAX_TTL=86400

# Renderer
RENDER_BROWSER_RETIRE_AFTER=30
RENDER_STEALTH_ENABLED=True
RENDER_CONTEXT_ISOLATION=True

# ---------- 前端 API 地址 ----------
# Docker Compose 模式使用 http://localhost:8000
# 如用 Cloudflare Tunnel 等则填公网地址
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- 前端 WebSocket 地址 ----------
# 直接连接后端 FastAPI WebSocket 时使用
# 如不配置则自动推导为 ws://<当前hostname>:8000
NEXT_PUBLIC_WS_URL=

# ---------- 时区 ----------
TZ=Asia/Shanghai
